@router.get("/posts/{post_id}", response_model=dict)
async def get_post(post_id: str, db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    result = await db.execute(
        select(ScheduledPost).where(
            ScheduledPost.id == post_id,
            ScheduledPost.user_id == current_user.id
        )
    )
    post = result.scalar_one_or_none()
    
    if not post:
        return {'status': 'error', 'message': '投稿が見つかりません'}
    
    image_data_with_urls = []
    if post.image_data:
        for img in post.image_data:
            img_dict = dict(img)
            if 'url' not in img_dict:
                img_dict['url'] = f"/static/images/{img.get('filename', '')}"
            image_data_with_urls.append(img_dict)
    
    post_dict = {
        'id': post.id,
        'account': post.account_username,
        'content': post.content,
        'langs': post.langs or ['ja'],
        'schedule_time': post.schedule_time.strftime('%Y-%m-%dT%H:%M') + 'Z' if post.schedule_time else None,
        'labels': post.labels or [],
        'status': post.status,
        'image_data': image_data_with_urls,
        'parent_post_id': post.parent_post_id,
        'external_reply_uri': post.external_reply_uri,
        'external_reply_cid': post.external_reply_cid,
        'error_message': post.error_message,
        'post_uri': post.post_uri,
        'reply_gate': post.reply_gate,
        'disable_quotes': post.disable_quotes,
        'is_quote': post.is_quote,
    }
    
    return {'status': 'success', 'data': post_dict}


from fastapi import UploadFile, Request

@router.post("/posts", response_model=dict)
async def create_post(
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
    account_did: str = Form(...),
    content: str = Form(""),
    schedule_time: Optional[str] = Form(None),
    language: Optional[str] = Form("ja"),
    image_data: Optional[str] = Form(None),
    labels: Optional[str] = Form(None),
    parent_post_id: Optional[str] = Form(None),
    external_reply_uri: Optional[str] = Form(None),
    external_reply_cid: Optional[str] = Form(None),
    reply_gate: Optional[str] = Form(None),
    disable_quotes: str = Form("0"),
    is_quote: str = Form("0"),
    source_post_id: Optional[str] = Form(None),
):
    # Get uploaded files from request
    form = await request.form()
    images = form.getlist('images')
    
    saved_images = []
    
    # Copy images from source post if source_post_id is provided
    if source_post_id and not images:
        should_duplicate_images = await _get_duplicate_images_setting(db, current_user.id)
        logging.warning(f"[DEBUG] source_post_id={source_post_id}, should_duplicate_images={should_duplicate_images}, user_id={current_user.id}")
        if should_duplicate_images:
            source_result = await db.execute(
                select(ScheduledPost).where(
                    ScheduledPost.id == source_post_id,
                    ScheduledPost.user_id == current_user.id
                )
            )
            source_post = source_result.scalar_one_or_none()
            
            if source_post and source_post.image_data:
                os.makedirs(settings.IMAGE_FOLDER, exist_ok=True)
                
                for idx, img_data in enumerate(source_post.image_data):
                    source_path = os.path.join(settings.IMAGE_FOLDER, img_data['filename'])
                    
                    if os.path.exists(source_path):
                        # Read original file and optimize
                        with open(source_path, 'rb') as src:
                            original_content = src.read()
                        
                        # Apply optimization
                        optimized_content, ext = optimize_image(original_content)
                        
                        new_filename = f"{uuid.uuid4()}{ext}"
                        new_path = os.path.join(settings.IMAGE_FOLDER, new_filename)
                        
                        with open(new_path, 'wb') as dst:
                            dst.write(optimized_content)
                        
                        saved_images.append({
                            'filename': new_filename,
                            'url': f'/static/images/{new_filename}',
                            'alt_text': img_data.get('alt_text', ''),
                            'order': img_data.get('order', idx),
                            'id': f"{uuid.uuid4()}",
                            'name': img_data.get('name', img_data['filename']),
                            'size': len(optimized_content),
                            'original_size': len(original_content)  # Store original size for UI
                        })
    
    # Handle pre-uploaded images from image_data (images already uploaded via /upload_image)
    # Skip if source_post_id is provided AND duplicate_images setting is False
    should_duplicate = await _get_duplicate_images_setting(db, current_user.id)
    if image_data and not (source_post_id and not should_duplicate):
        try:
            img_data_parsed = json.loads(image_data) if isinstance(image_data, str) else image_data
            os.makedirs(settings.IMAGE_FOLDER, exist_ok=True)
            
            for img_info in img_data_parsed:
                server_filename = img_info.get('serverFilename', '')
                if server_filename:
                    filepath = os.path.join(settings.IMAGE_FOLDER, server_filename)
                    if os.path.exists(filepath):
                        saved_images.append({
                            'filename': server_filename,
                            'url': f'/static/images/{server_filename}',
                            'alt_text': img_info.get('alt', ''),
                            'order': img_info.get('order', len(saved_images)),
                            'id': img_info.get('id', ''),
                            'name': img_info.get('name', server_filename),
                            'size': img_info.get('size', 0),
                        })
        except json.JSONDecodeError:
            pass
    
    # Handle newly uploaded images (via multipart/form-data)
    # Only process if image_data (serverFilename) is NOT provided
    # This prevents duplicate processing when images are pre-uploaded
    if images and len(images) > 0 and not image_data:
        os.makedirs(settings.IMAGE_FOLDER, exist_ok=True)
        for idx, img in enumerate(images):
            if img and img.filename:
                img_content = await img.read()
                optimized_content, ext = optimize_image(img_content)
                filename = f"{uuid.uuid4()}{ext}"
                filepath = os.path.join(settings.IMAGE_FOLDER, filename)
                
                with open(filepath, 'wb') as f:
                    f.write(optimized_content)
                
                saved_images.append({
                    'filename': filename,
                    'url': f'/static/images/{filename}',
                    'alt_text': '',
                    'order': idx,
                    'size': len(optimized_content)
                })
    
    # Build final image list - saved_images already contains all images
    image_list = saved_images if saved_images else []
    
    label_list = []
    if labels:
        try:
            label_list = json.loads(labels) if isinstance(labels, str) else labels
        except (json.JSONDecodeError, TypeError):
            label_list = []

    reply_gate_list = []
    if reply_gate:
        try:
            reply_gate_list = json.loads(reply_gate) if isinstance(reply_gate, str) else reply_gate
        except (json.JSONDecodeError, TypeError):
            reply_gate_list = []
    
    result = await db.execute(
        select(BlueskyAccount).where(
            BlueskyAccount.did == account_did,
            BlueskyAccount.user_id == current_user.id
        )
    )
    account = result.scalar_one_or_none()
    
    if not account:
        return {'status': 'error', 'message': f'DID {account_did} のアカウントが見つかりません'}
    
    schedule_datetime = None
    if schedule_time:
        schedule_datetime = datetime.fromisoformat(schedule_time.replace('Z', '+00:00'))
        if schedule_datetime.tzinfo is None:
            jst = timezone(timedelta(hours=9))
            schedule_datetime = schedule_datetime.replace(tzinfo=jst)
        schedule_datetime = schedule_datetime.replace(tzinfo=None)
    
    new_post = ScheduledPost(
        id=str(uuid.uuid4()),
        account_did=account_did,
        account_username=account.username,
        user_id=current_user.id,
        content=content,
        langs=[language] if language else ['ja'],
        schedule_time=schedule_datetime,
        image_data=image_list,
        labels=label_list,
        status='pending',
        parent_post_id=parent_post_id,
        external_reply_uri=external_reply_uri,
        external_reply_cid=external_reply_cid,
        reply_gate=reply_gate_list,
        disable_quotes=disable_quotes == '1' or disable_quotes == 'true',
        is_quote=is_quote == '1' or is_quote == 'true',
    )
    
    db.add(new_post)
    await db.commit()
    
    if schedule_datetime:
        from app.scheduler import schedule_post_job
        await schedule_post_job(new_post.id, schedule_datetime)
    
    if content:
        used_hashtags = extract_hashtags_from_text(content)
        for tag_text in used_hashtags:
            result = await db.execute(
                select(HashtagUsage).where(
                    HashtagUsage.user_id == current_user.id,
                    HashtagUsage.tag == tag_text
                )
            )
            usage = result.scalar_one_or_none()
            
    if usage:
        usage.last_used = datetime.now()
    else:
                usage = HashtagUsage(
                    account_username=account.username,
                    user_id=current_user.id,
                    tag=tag_text
                )
                db.add(usage)
        
        result = await db.execute(
            select(HashtagUsage)
            .where(HashtagUsage.user_id == current_user.id)
            .order_by(HashtagUsage.last_used.desc())
        )
        all_usages = result.scalars().all()
        
        if len(all_usages) > MAX_HASHTAGS_PER_USER:
            to_delete = all_usages[MAX_HASHTAGS_PER_USER:]
            for usage in to_delete:
                await db.delete(usage)
        
        await db.commit()
    
    return {'status': 'success', 'message': '投稿をスケジュールしました'}


@router.post("/edit_scheduled_post/{post_id}", response_model=dict)
async def edit_scheduled_post(
    post_id: str,
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    import uuid
    import json
    import os
    from datetime import datetime
    from fastapi import Request
    from app.scheduler import cancel_scheduled_job, schedule_post_job
    
    result = await db.execute(
        select(ScheduledPost).where(
            ScheduledPost.id == post_id,
            ScheduledPost.user_id == current_user.id
        )
    )
    post = result.scalar_one_or_none()
    
    if not post:
        return {'status': 'error', 'message': '投稿が見つかりません'}
    
    if post.status == 'posted':
        return {'status': 'error', 'message': '既に投稿済みのため編集できません'}
    
    form = await request.form()
    account_did = form.get('account_did')
    content = form.get('content', '')
    schedule_time = form.get('schedule_time')
    language = form.get('language', 'ja')
    image_data = form.get('image_data')
    labels = form.get('labels')
    parent_post_id = form.get('parent_post_id')
    external_reply_uri = form.get('external_reply_uri')
    external_reply_cid = form.get('external_reply_cid')
    reply_gate = form.get('reply_gate')
    disable_quotes = form.get('disable_quotes', '0')
    is_quote = form.get('is_quote', '0')
    images = form.getlist('images')
    
    account_result = await db.execute(
        select(BlueskyAccount).where(
            BlueskyAccount.did == account_did,
            BlueskyAccount.user_id == current_user.id
        )
    )
    account = account_result.scalar_one_or_none()
    if not account:
        return {'status': 'error', 'message': 'アカウントが見つかりません'}
    
    schedule_datetime = None
    if schedule_time:
        schedule_datetime = datetime.fromisoformat(schedule_time.replace('Z', '+00:00'))
        if schedule_datetime.tzinfo is None:
            from datetime import timezone, timedelta
            jst = timezone(timedelta(hours=9))
            schedule_datetime = schedule_datetime.replace(tzinfo=jst)
        schedule_datetime = schedule_datetime.replace(tzinfo=None)
    
    post.account_did = account_did
    post.account_username = account.username
    post.content = content
    post.langs = [language] if language else ['ja']
    post.schedule_time = schedule_datetime
    post.labels = json.loads(labels) if labels else []
    post.parent_post_id = parent_post_id
    post.external_reply_uri = external_reply_uri
    post.external_reply_cid = external_reply_cid
    post.reply_gate = json.loads(reply_gate) if reply_gate else []
    post.disable_quotes = disable_quotes == '1' or disable_quotes == 'true'
    post.is_quote = is_quote == '1' or is_quote == 'true'
    
    await cancel_scheduled_job(post_id)
    
    if schedule_datetime:
        await schedule_post_job(post.id, schedule_datetime)
    
    await db.commit()
    
    return {'status': 'success', 'message': '投稿を更新しました'}


@router.delete("/posts/{post_id}", response_model=dict)
async def delete_post(post_id: str, db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    result = await db.execute(
        select(ScheduledPost).where(
            ScheduledPost.id == post_id,
            ScheduledPost.user_id == current_user.id
        )
    )
    post = result.scalar_one_or_none()
    
    if not post:
        return {'status': 'error', 'message': '投稿が見つかりません'}
    
    if post.status == 'posting':
        return {'status': 'error', 'message': 'この投稿は投稿中のため削除できません'}, 403
    
    if post.image_data:
        import os
        for img in post.image_data:
            image_path = os.path.join(settings.IMAGE_FOLDER, img['filename'])
            if os.path.exists(image_path):
                os.remove(image_path)
    
    from app.scheduler import cancel_scheduled_job
    await cancel_scheduled_job(post_id)
    
    await db.delete(post)
    await db.commit()
    
    return {'status': 'success', 'message': '投稿を削除しました'}


