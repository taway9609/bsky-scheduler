@router.get("/hashtags", response_model=dict)
async def get_hashtag_history(
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    result = await db.execute(
        select(HashtagUsage)
        .where(HashtagUsage.user_id == current_user.id)
        .order_by(HashtagUsage.last_used.desc())
        .limit(MAX_HASHTAGS_PER_USER)
    )
    usages = result.scalars().all()
    
    return {'status': 'success', 'data': [usage.tag for usage in usages]}


@router.post("/hashtags/clear", response_model=dict)
async def clear_hashtag_history(
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    await db.execute(
        delete(HashtagUsage).where(HashtagUsage.user_id == current_user.id)
    )
    await db.commit()
    return {'status': 'success', 'message': 'ハッシュタグ履歴をクリアしました'}


