@router.post("/upload_image", response_model=dict)
async def upload_image(
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    import uuid
    import os
    import logging
    
    logger = logging.getLogger(__name__)
    
    form = await request.form()
    image = form.get('image')
    
    logger.debug(f"Image upload request received. Filename: {image.filename if image else 'None'}")
    
    if not image or not image.filename:
        logger.warning("Image upload failed - no image file provided")
        return {'status': 'error', 'message': '画像が選択されていません'}
    
    original_size = 0
    try:
        img_content = await image.read()
        original_size = len(img_content)
        logger.debug(f"Image read successfully. Original size: {original_size} bytes")
    except Exception as e:
        logger.error(f"Image upload failed - error reading image: {str(e)}")
        return {'status': 'error', 'message': f'画像の読み込みに失敗しました: {str(e)}'}
    
    logger.debug(f"Starting image optimization. File size: {original_size} bytes")
    optimized_content, ext = optimize_image(img_content)
    logger.debug(f"Image optimization completed. Optimized size: {len(optimized_content)} bytes, Extension: {ext}")
    
    os.makedirs(settings.IMAGE_FOLDER, exist_ok=True)
    filename = f"{uuid.uuid4()}{ext}"
    filepath = os.path.join(settings.IMAGE_FOLDER, filename)
    
    with open(filepath, 'wb') as f:
        f.write(optimized_content)
    
    optimized_size = len(optimized_content)
    
    return {
        'status': 'success',
        'filename': filename,
        'url': f'/static/images/{filename}',
        'size': optimized_size,
        'original_size': original_size,
        'ext': ext
    }


@router.delete("/image/{filename}", response_model=dict)
async def delete_image(
    filename: str,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    import os
    
    filepath = os.path.join(settings.IMAGE_FOLDER, filename)
    
    if os.path.exists(filepath):
        os.remove(filepath)
        return {'status': 'success', 'message': f'画像を削除しました: {filename}'}
    else:
        return {'status': 'error', 'message': f'画像が見つかりません: {filename}'}


@router.post("/edit_account", response_model=dict)
async def edit_account(db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    from fastapi import Request
    from app.services.bluesky import authenticate_account
    from app.utils import encrypt_password
    import json
    
    # Get form data
    body = await request.body()
    try:
        data = json.loads(body)
    except json.JSONDecodeError:
        return {'status': 'error', 'message': '無効なリクエストです'}
    
    identifier = data.get('identifier')
    password = data.get('password')
    
    if not identifier or not password:
        return {'status': 'error', 'message': '識別子とパスワードを入力してください'}
    
    # Authenticate the account
    auth_result = await authenticate_account(identifier, password)
    
    if 'error' in auth_result:
        return {'status': 'error', 'message': auth_result['error']}
    
    # Update the account in the database
    result = await db.execute(
        select(BlueskyAccount).where(
            BlueskyAccount.username == auth_result['username'],
            BlueskyAccount.user_id == current_user.id
        )
    )
    account = result.scalar_one_or_none()
    
    if not account:
        return {'status': 'error', 'message': 'アカウントが見つかりません'}
    
    # Update account information
    account.did = auth_result['did']
    account.display_name = auth_result.get('display_name', '')
    account.password = encrypt_password(password)
    
    await db.commit()
    
    return {'status': 'success', 'message': 'アカウント情報を更新しました'}


@router.post("/sync_account/{did}", response_model=dict)
async def sync_account_alias(did: str, db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    from app.services.bluesky import get_profile
    from app.config import settings
    from fastapi import HTTPException, status
    
    # Get account from database
    result = await db.execute(
        select(BlueskyAccount).where(
            BlueskyAccount.did == did,
            BlueskyAccount.user_id == current_user.id
        )
    )
    account = result.scalar_one_or_none()
    
    if not account:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail='アカウントが見つかりません')
    
    try:
        # Get profile information from Bluesky
        profile = await get_profile(account.username)
        if profile and hasattr(profile, 'display_name'):
            account.display_name = profile.display_name or ''
            await db.commit()
            return {'status': 'success', 'message': 'アカウント情報を更新しました', 'display_name': profile.display_name or ''}
        else:
            raise HTTPException(status_code=status.HTTP_502_BAD_GATEWAY, detail='プロフィール情報の取得に失敗しました')
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f'アカウント情報の同期に失敗しました: {str(e)}')


