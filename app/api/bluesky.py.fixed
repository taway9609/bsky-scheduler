@router.post("/duplicate_post/{post_id}", response_model=dict)
async def duplicate_post(post_id: str, db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    import uuid
    import os
    import copy
    
    result = await db.execute(
        select(ScheduledPost).where(
            ScheduledPost.id == post_id,
            ScheduledPost.user_id == current_user.id
        )
    )
    post = result.scalar_one_or_none()
    if not post:
        return {'status': 'error', 'message': '投稿が見つかりません'}
    
    new_image_data = None
    new_image_data = None
    if post.image_data:
        should_duplicate_images = await _get_duplicate_images_setting(db, current_user.id)
        if should_duplicate_images:
            new_image_data = []
            os.makedirs(settings.IMAGE_FOLDER, exist_ok=True)
            
            for img_info in post.image_data:
                source_filename = img_info.get('filename', '')
                source_path = os.path.join(settings.IMAGE_FOLDER, source_filename)
                
                if source_filename and os.path.exists(source_path):
                    # Read and optimize the image
                    with open(source_path, 'rb') as src:
                        original_content = src.read()
                    
                    optimized_content, ext = optimize_image(original_content)
                    new_filename = f"{uuid.uuid4()}{ext}"
                    new_path = os.path.join(settings.IMAGE_FOLDER, new_filename)
                    
                    with open(new_path, 'wb') as dst:
                        dst.write(optimized_content)
                    
                    new_image_data.append({
                        'filename': new_filename,
                        'url': f'/static/images/{new_filename}',
                        'alt_text': img_info.get('alt_text', ''),
                        'order': len(new_image_data),
                        'id': f"{uuid.uuid4()}",
                        'name': img_info.get('name', source_filename),
                        'size': len(optimized_content),
                        'original_size': len(original_content)  # Add original size
                    })
    
    new_post = ScheduledPost(
        id=str(uuid.uuid4()),
        account_did=post.account_did,
        account_username=post.account_username,
        user_id=current_user.id,
        content=post.content,
        langs=post.langs,
        schedule_time=post.schedule_time,
        image_data=new_image_data,
        labels=post.labels,
        parent_post_id=post.parent_post_id,
        external_reply_uri=post.external_reply_uri,
        external_reply_cid=post.external_reply_cid,
        reply_gate=post.reply_gate,
        disable_quotes=post.disable_quotes,
        is_quote=post.is_quote,
        status='pending',
    )
    db.add(new_post)
    await db.commit()
    return {'status': 'success', 'message': '投稿を複製しました', 'data': {'new_post_id': new_post.id}}


@router.post("/delete_scheduled_post/{post_id}", response_model=dict)
