@router.post("/delete_selected_posts", response_model=dict)
async def delete_selected_posts(
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    from fastapi import Body
    import json
    
    body = await request.body()
    try:
        data = json.loads(body)
    except json.JSONDecodeError:
        return {'status': 'error', 'message': '無効なリクエストです'}
    
    post_ids = data.get('post_ids', [])
    
    if not post_ids:
        return {'status': 'error', 'message': '削除する投稿が選択されていません'}
    
    deleted_count = 0
    for post_id in post_ids:
        result = await db.execute(
            select(ScheduledPost).where(
                ScheduledPost.id == post_id,
                ScheduledPost.user_id == current_user.id
            )
        )
        post = result.scalar_one_or_none()
        
        if post:
            if post.status == 'posting':
                continue
            
            if post.image_data:
                import os
                for img in post.image_data:
                    image_path = os.path.join(settings.IMAGE_FOLDER, img.get('filename', ''))
                    if image_path and os.path.exists(image_path):
                        os.remove(image_path)
            
            from app.scheduler import cancel_scheduled_job
            await cancel_scheduled_job(post_id)
            
            await db.delete(post)
            deleted_count += 1
    
    await db.commit()
    return {'status': 'success', 'message': f'{deleted_count}件の投稿を削除しました', 'deleted_count': deleted_count}


