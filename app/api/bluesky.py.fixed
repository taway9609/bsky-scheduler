@router.post("/resolve_external_url", response_model=dict)
async def resolve_external_url(
    request: Request,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    body = await request.body()
    try:
        data = json.loads(body)
    except json.JSONDecodeError:
        return {'status': 'error', 'message': '無効なリクエストです'}

    url = data.get('url', '')
    if not url:
        return {'status': 'error', 'message': 'URLが指定されていません'}

    patterns = [
        r'bsky\.app/profile/([^/]+)/post/([a-zA-Z0-9]+)',
        r'([a-zA-Z0-9-]+\.bsky\.social)/post/([a-zA-Z0-9]+)',
    ]
    
    handle = None
    post_id = None
    
    for pattern in patterns:
        match = re.search(pattern, url)
        if match:
            handle = match.group(1)
            post_id = match.group(2)
            break
    
    if not handle or not post_id:
        return {'status': 'error', 'message': '無効なBluesky URLです'}
    
    try:
        from app.config import settings
        import httpx
        
        if handle == 'profile':
            return {'status': 'error', 'message': '無効なURLです'}
        
        if settings.USE_MOCK_BLUESKY:
            from tests.utils.mock_bluesky import MockBlueskyClient
            client = MockBlueskyClient()
        else:
            from atproto import Client
            client = Client()
        
        post_uri = f'at://{handle}/app.bsky.feed.post/{post_id}'
        post_cid = None
        content = ''
        author_handle = handle
        author_display_name = handle
        
        # Try to get post record
        try:
            response = client.com.atproto.repo.get_record({
                'repo': handle,
                'collection': 'app.bsky.feed.post',
                'rkey': post_id,
            })
            
            post_uri = response.uri
            post_cid = response.cid
            
            record = response.value
            if record:
                content = getattr(record, 'text', '') or ''
        except Exception as e:
            error_msg = str(e)
            if 'RecordNotFound' in error_msg or 'Record not found' in error_msg:
                return {'status': 'error', 'message': 'この投稿は削除されたか存在しません'}
            logger = logging.getLogger(__name__)
            logger.warning(f"Failed to get record for {handle}/{post_id}: {e}")
        
        # Get profile using api.bsky.app (doesn't require auth)
        try:
            profile_url = 'https://api.bsky.app/xrpc/app.bsky.actor.getProfile'
            profile_response = httpx.get(profile_url, params={'actor': handle}, timeout=10)
            if profile_response.status_code == 200:
                profile_data = profile_response.json()
                author_display_name = profile_data.get('displayName') or handle
        except Exception as e:
            logger = logging.getLogger(__name__)
            logger.warning(f"Failed to get profile for {handle}: {e}")
        
        return {
            'status': 'success',
            'data': {
                'post_uri': post_uri,
                'post_cid': post_cid,
                'content': content,
                'account': author_handle,
                'display_name': author_display_name
            }
        }
            
    except Exception as e:
        logger = logging.getLogger(__name__)
        logger.error(f"Error resolving external URL: {e}")
        return {'status': 'error', 'message': f'URLの解決に失敗しました: {str(e)}'}
