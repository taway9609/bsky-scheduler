MAX_HASHTAGS_PER_USER = 50
DUPLICATE_IMAGES_KEY = "duplicate_images"

async def _get_duplicate_images_setting(db: AsyncSession, user_id: int) -> bool:
    result = await db.execute(
        select(AppSettings).where(
            AppSettings.key == DUPLICATE_IMAGES_KEY,
            AppSettings.user_id == user_id
        )
    )
    setting = result.scalar_one_or_none()
    if setting:
        return setting.value.lower() == 'true'
    return True

async def _set_duplicate_images_setting(db: AsyncSession, user_id: int, value: bool):
    result = await db.execute(
        select(AppSettings).where(
            AppSettings.key == DUPLICATE_IMAGES_KEY,
            AppSettings.user_id == user_id
        )
    )
    setting = result.scalar_one_or_none()
    if setting:
        setting.value = 'true' if value else 'false'
    else:
        setting = AppSettings(
            key=DUPLICATE_IMAGES_KEY,
            value='true' if value else 'false',
            user_id=user_id
        )
        db.add(setting)

router = APIRouter()


@router.get("/scheduler", response_class=HTMLResponse)
async def scheduler_page(request: Request, db: AsyncSession = Depends(get_db)):
    from app.main import templates

    token = request.cookies.get('access_token')
    if not token:
        auth_header = request.headers.get('Authorization', '')
        if auth_header.startswith('Bearer '):
            token = auth_header.replace('Bearer ', '')

    user = None
    if token:
        user_id = decode_token(token)
        if user_id:
            result = await db.execute(select(User).where(User.id == user_id))
            user = result.scalar_one_or_none()

    if not user or not user.is_active:
        return RedirectResponse(
            url="/auth/login?return_url=/bluesky/scheduler",
            status_code=302
        )

    result = await db.execute(select(AppSettings))
    settings = result.scalars().all()
    settings_dict = {s.key: s.value for s in settings}

    return templates.TemplateResponse("bluesky/_base.html", {
        "request": request,
        "app_settings": settings_dict,
        "username": user.username,
        "accounts": {},
        "scheduled_posts": {},
        "is_admin": user.is_admin,
        "user_id": user.id,
        "is_dev": os.environ.get("IS_DEV", "false").lower() == "true",
    })


@router.get("/accounts", response_model=dict)
async def get_accounts(db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    result = await db.execute(select(BlueskyAccount).where(BlueskyAccount.user_id == current_user.id))
    accounts = result.scalars().all()
    
    accounts_data = {
        acc.username: {
            'did': acc.did,
            'username': acc.username,
            'handle': acc.username,
            'display_name': acc.display_name or ''
        }
        for acc in accounts
    }
    return {'status': 'success', 'accounts': accounts_data}


@router.get("/get_accounts", response_model=dict)
async def get_accounts_alias(db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    return await get_accounts(db, current_user)


@router.post("/accounts", response_model=dict)
async def add_account(
    account_data: AccountCreate,
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    from app.services.bluesky import authenticate_account
    from app.utils import encrypt_password
    from sqlalchemy.dialects.postgresql import insert as pg_insert
    from sqlalchemy.exc import IntegrityError
    
    auth_result = await authenticate_account(
        account_data.identifier,
        account_data.password
    )
    
    if 'error' in auth_result:
        return {'status': 'error', 'message': auth_result['error']}
    
    encrypted_password = encrypt_password(account_data.password)
    
    stmt = pg_insert(BlueskyAccount).values(
        did=auth_result['did'],
        username=auth_result['username'],
        display_name=auth_result.get('display_name', ''),
        password=encrypted_password,
        user_id=current_user.id
    ).on_conflict_do_update(
        index_elements=['did'],
        set_=dict(
            username=auth_result['username'],
            display_name=auth_result.get('display_name', ''),
            password=encrypted_password,
        )
    )
    
    await db.execute(stmt)
    await db.commit()
    
    result = await db.execute(select(BlueskyAccount).where(BlueskyAccount.user_id == current_user.id))
    accounts = result.scalars().all()
    accounts_data = {
        acc.username: {
            'did': acc.did,
            'username': acc.username,
            'handle': acc.username,
            'display_name': acc.display_name or ''
        }
        for acc in accounts
    }
    return {'status': 'success', 'message': 'アカウントを追加しました', 'accounts': accounts_data}


@router.delete("/accounts/{did}", response_model=dict)
async def remove_account(did: str, db: AsyncSession = Depends(get_db), current_user: User = Depends(get_current_user)):
    result = await db.execute(
        select(BlueskyAccount).where(
            BlueskyAccount.did == did,
            BlueskyAccount.user_id == current_user.id
        )
    )
    account = result.scalar_one_or_none()
    
    if not account:
        return {'status': 'error', 'message': 'アカウントが見つかりません'}
    
    username = account.username
    
    result = await db.execute(
        select(ScheduledPost).where(
            ScheduledPost.account_username == username,
            ScheduledPost.user_id == current_user.id
        )
    )
    posts = result.scalars().all()
    for post in posts:
        await db.delete(post)
    
    await db.delete(account)
    await db.commit()
    
    result = await db.execute(select(BlueskyAccount).where(BlueskyAccount.user_id == current_user.id))
    accounts = result.scalars().all()
    accounts_data = {
        acc.username: {
            'did': acc.did,
            'username': acc.username,
            'handle': acc.username,
            'display_name': acc.display_name or ''
        }
        for acc in accounts
    }
    return {'status': 'success', 'message': 'アカウントを削除しました', 'accounts': accounts_data}


@router.get("/posts", response_model=dict)
async def get_posts(
    sort_by: str = "created_at",
    sort_order: str = "desc",
    db: AsyncSession = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    sort_column = ScheduledPost.created_at
    if sort_by == "schedule_time":
        sort_column = ScheduledPost.schedule_time
    
    if sort_order == "asc":
        result = await db.execute(
            select(ScheduledPost)
            .where(ScheduledPost.user_id == current_user.id)
            .options(selectinload(ScheduledPost.account_ref))
            .order_by(sort_column.asc())
        )
    else:
        result = await db.execute(
            select(ScheduledPost)
            .where(ScheduledPost.user_id == current_user.id)
            .options(selectinload(ScheduledPost.account_ref))
            .order_by(sort_column.desc())
        )
    posts = result.scalars().all()

    # N+1 fix: Pre-fetch all parent posts
    parent_post_ids = [post.parent_post_id for post in posts if post.parent_post_id]
    parent_posts_content = {}
    if parent_post_ids:
        parent_result = await db.execute(
            select(ScheduledPost.id, ScheduledPost.content)
            .where(ScheduledPost.id.in_(parent_post_ids))
        )
        for parent_id, parent_content in parent_result.all():
            parent_posts_content[parent_id] = parent_content or '(本文なし)'

    posts_data = []
    
    # 開発環境でのテスト用投稿済み投稿
    if os.environ.get('IS_DEV', 'false').lower() == 'true' and not posts:
        posts_data.append({
            'id': 'test-post-001',
            'account': 'testuser.bsky.social',
            'content': 'これはテスト投稿です。投稿済みの状態でBlueskyで開くボタンが表示されることを確認します。',
            'langs': ['ja'],
            'schedule_time': '2024-01-01T12:00:00Z',
            'created_at': '2024-01-01T10:00:00Z',
            'labels': [],
            'status': 'posted',
            'image_data': [],
            'parent_post_id': None,
            'external_reply_uri': None,
            'external_reply_cid': None,
            'error_message': None,
            'post_uri': 'https://bsky.app/profile/testuser.bsky.social/post/3kpxgq6d7a22b',
            'reply_gate': [],
            'disable_quotes': False,
            'is_quote': False,
        })
    
    for post in posts:
        image_data_with_urls = []
        if post.image_data:
            for img in post.image_data:
                img_dict = dict(img)
                if 'url' not in img_dict:
                    img_dict['url'] = f"/static/images/{img.get('filename', '')}"
                image_data_with_urls.append(img_dict)

        post_dict = {
            'id': post.id,
            'account': post.account_username,
            'content': post.content,
            'langs': post.langs or ['ja'],
            'schedule_time': post.schedule_time.strftime('%Y-%m-%dT%H:%M') + 'Z' if post.schedule_time else None,
            'created_at': post.created_at.strftime('%Y-%m-%dT%H:%M') + 'Z' if post.created_at else None,
            'labels': post.labels or [],
            'status': post.status,
            'image_data': image_data_with_urls,
            'parent_post_id': post.parent_post_id,
            'external_reply_uri': post.external_reply_uri,
            'external_reply_cid': post.external_reply_cid,
            'error_message': post.error_message,
            'post_uri': post.post_uri,
            'reply_gate': post.reply_gate,
            'disable_quotes': post.disable_quotes,
            'is_quote': post.is_quote,
        }

        if post.parent_post_id and post.parent_post_id in parent_posts_content:
            parent_content = parent_posts_content[post.parent_post_id]
            post_dict['parent_post_preview'] = (
                parent_content[:100] + '...' if len(parent_content) > 100 else parent_content
            )

        posts_data.append(post_dict)
    
    return {'status': 'success', 'data': posts_data}


